# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillbridge
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/skillbridge

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=your-secret-key-change-in-production

# AI - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Jobs - Get from https://jooble.org/api/about
JOOBLE_API_KEY=your-jooble-api-key

# Optional - GitHub personal access token for higher rate limits
GITHUB_TOKEN=
